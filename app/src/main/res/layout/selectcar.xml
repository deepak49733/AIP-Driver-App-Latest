<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:cardElevation="@dimen/margin_2dp"
    android:layout_margin="@dimen/margin_2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/margin_2dp">

        <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/car_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/margin_30dp"
            android:paddingBottom="@dimen/margin_5dp"
            android:src="@drawable/ic_car"
            app:civ_border_color="@color/orange"
            app:civ_border_width="1dp" />

        <TextView
            android:id="@+id/carname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:padding="@dimen/margin_5dp"
            android:gravity="center"
            android:layout_toRightOf="@+id/car_image"
            android:layout_centerInParent="true"
            android:layout_toLeftOf="@+id/carnumber"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/carnumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:padding="@dimen/margin_5dp"
            android:text="@string/app_name"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/imageButtonArrow"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <ImageButton
            android:id="@+id/imageButtonArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_arrowright" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>