<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:gravity="center"
            android:padding="@dimen/margin_10dp"
            android:id="@+id/title_load"
            android:text="Upload Photos"

            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/white" />
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </RelativeLayout>









    <LinearLayout
        android:id="@+id/upload_id_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:orientation="horizontal"
        android:visibility="visible"
        android:padding="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/branch_lable"
        app:layout_constraintStart_toStartOf="@+id/branch_lable"
        app:layout_constraintTop_toBottomOf="@+id/tv_attach">

        <RelativeLayout
            android:id="@+id/rl_img1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginRight="@dimen/_6sdp"
            android:background="@drawable/dotted_outline_blue">

            <ImageView
                android:id="@+id/iv_img1"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attachment_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"

                android:layout_centerHorizontal="true"
                android:text="@string/package2"
                android:textColor="@color/grey_shade1" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_ivImgg1"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/_6sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_imgg1"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_80sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_close_front"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="2dp"
                android:src="@drawable/ic_close"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_imgg1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:text="@string/image_one"
                android:textColor="@color/black" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_img2"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginRight="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/dotted_outline_blue">

            <ImageView
                android:id="@+id/iv_img2"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attachment_grey" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="@string/package2"
                android:textColor="@color/grey_shade1" />


        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upload_id_ll2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@+id/branch_lable"
        app:layout_constraintStart_toStartOf="@+id/branch_lable"
        app:layout_constraintTop_toBottomOf="@+id/tv_attach">

    <RelativeLayout
            android:id="@+id/rl_ivImgg2"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/_6sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_imgg2"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_80sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_closeimgg2"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="2dp"
                android:src="@drawable/ic_close"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_imgg2"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:text="@string/image_two"
                android:textColor="@color/black" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rl_img3"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginRight="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/dotted_outline_blue">

            <ImageView
                android:id="@+id/iv_img3"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attachment_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"

                android:layout_centerHorizontal="true"
                android:text="@string/misc1"
                android:textColor="@color/grey_shade1" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_ivImgg3"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/_6sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_imgg3"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_80sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_closeimgg3"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="2dp"
                android:src="@drawable/ic_close"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_imgg3"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:text="@string/image_two"
                android:textColor="@color/black" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rl_img4"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1"
            android:background="@drawable/dotted_outline_blue">

            <ImageView
                android:id="@+id/iv_img4"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attachment_grey" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"

                android:layout_centerHorizontal="true"
                android:text="@string/misc2"
                android:textColor="@color/grey_shade1" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_ivImgg4"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/_6sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_imgg4"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_80sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_closeimgg4"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="2dp"
                android:src="@drawable/ic_close"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_imgg4"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:text="@string/image_two"
                android:textColor="@color/black" />
        </RelativeLayout>


    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submit"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="24dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:text="@string/done"
        android:textColor="@color/white"
        android:layout_marginLeft="80dp"
        android:layout_marginRight="80dp"/>
</LinearLayout>
