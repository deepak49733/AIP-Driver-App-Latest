<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/orange"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/ll_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/iv_map"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/pins"
                android:visibility="gone"
                app:tint="@color/orange" />
        <!-- Farm Name -->
        <TextView
            android:id="@+id/farmsname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Farm Name"
            android:layout_toLeftOf="@+id/photopending"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/photopending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uploadphoto"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_toLeftOf="@+id/iv_map"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
        </RelativeLayout>


        <!-- Order Quantity -->
        <TextView
            android:id="@+id/loadDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text=""
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartRide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/green"
                android:text="Start"
                android:visibility="gone"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnPauseRide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/orange"
                android:text="Pause"
                android:visibility="gone"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnCompleteRide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:backgroundTint="@color/green"
                android:text="Complete"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>