<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_farm_delivery_details"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_orange_button_selector"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:text="M7 Delivery Details"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Notification Icon shown ONLY when isINS is "Yes" -->
    <ImageView
        android:id="@+id/iv_ins_notification"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:contentDescription="Instruction Alert"
        android:elevation="3dp"
        android:src="@drawable/ic_notification_bell"
        android:visibility="gone" />

</RelativeLayout>
