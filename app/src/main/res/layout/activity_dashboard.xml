<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".activities.ui.DashboardActivity">

    <!-- Top Logo Header -->
    <LinearLayout
        android:id="@+id/ll_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_studlink_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/studlink_title"
            android:textColor="#000000"
            android:textSize="32sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_studlink_logo_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/studlink_logo_desc"
            android:src="@drawable/ic_studlink_nodes" />
    </LinearLayout>

    <!-- Center Navigation Buttons Stack -->
    <LinearLayout
        android:id="@+id/ll_menu_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Start Route Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_start_route"
            android:layout_width="250dp"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_orange_button_selector"
            android:elevation="2dp"
            android:text="@string/start_route"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Route Planning Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_route_planning"
            android:layout_width="250dp"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_orange_button_selector"
            android:elevation="2dp"
            android:text="@string/route_planning"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Driver Schedule Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_driver_schedule"
            android:layout_width="250dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_orange_button_selector"
            android:elevation="2dp"
            android:text="@string/driver_schedule"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom LOGOUT Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_orange_button_selector"
        android:elevation="2dp"
        android:text="@string/logout_btn"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

</RelativeLayout>
