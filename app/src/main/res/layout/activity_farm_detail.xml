<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ui.FarmDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/cl_appbar"
        android:background="@color/colorPrimaryDark">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/iv_back"
        app:tint="@color/white"
        android:layout_marginStart="@dimen/margin_12dp"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        android:id="@+id/tv_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:text=""
        android:layout_marginStart="@dimen/margin_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/margin_16dp"
        android:gravity="center_vertical"
       />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_appbar"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/margin_16dp"
        android:id="@+id/ll_root"

        android:orientation="vertical">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_name"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/name"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/farm_name"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/farmName"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_officephone"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/contact"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/office_phone"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/farmMobile"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_emergency"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/emergency"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/emergency_mobile"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/emergencyMobile"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_emergencyAlternate"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/emergencyAlternate"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/emergency_mobile_alternate"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/emergencyAlternateMobile"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_address"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/address"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/address"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/farmAddress"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:maxLines="5"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_directions"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/directions"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/Instruction"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/instruction"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:maxLines="5"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_images"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/images"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/image"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:id="@+id/iv_farm"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_imagesdrop"
            android:layout_margin="@dimen/margin_8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/dropimages"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/dropimage"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_farmdrop"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>





    </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginLeft="@dimen/margin_16dp"
        android:layout_marginRight="@dimen/margin_16dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:text="@string/start"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/white" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toTopOf="@id/btnStart"
    app:layout_constraintEnd_toEndOf="parent"
    android:id="@+id/ll_buttons"
    android:visibility="gone"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginBottom="24dp"
    >
    <Button
        android:id="@+id/pause"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_6dp"
        android:layout_marginRight="@dimen/margin_6dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:text="@string/pause"
        android:textColor="@color/white" />
    <Button
        android:id="@+id/resume"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_6dp"
        android:layout_marginRight="@dimen/margin_6dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:visibility="gone"
        android:text="@string/resume"

        android:textColor="@color/white" />
    <Button
        android:id="@+id/end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/margin_6dp"
        android:layout_marginRight="@dimen/margin_6dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:text="@string/complete_delivery"
        android:textColor="@color/white" />
    <Button
        android:id="@+id/finish"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/margin_6dp"
        android:layout_marginRight="@dimen/margin_6dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:padding="12dp"
        android:visibility="gone"
        android:text="@string/finish"
        app:layout_constraintBottom_toTopOf="@id/btnStart"

        android:textColor="@color/white" />
</LinearLayout>


    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:id="@+id/bgTrasnparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#80000000"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:layout_marginStart="@dimen/margin_16dp"
        android:layout_marginEnd="@dimen/margin_16dp"
        android:layout_marginBottom="100dp"
        android:id="@+id/cl_largeImage"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_appbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/iv_largeview"
            android:src="@drawable/ic_launcher_"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/margin_24dp"
            android:layout_height="@dimen/margin_24dp"
            android:layout_marginEnd="@dimen/margin_6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_close"
            android:contentDescription="Close" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>