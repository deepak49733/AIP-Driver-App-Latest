<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/filter_selected_bg" />
            <corners android:radius="@dimen/_20sdp" />
            <stroke android:width="1dp" android:color="@color/filter_selected_bg" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/filter_unselected_bg" />
            <corners android:radius="@dimen/_20sdp" />
            <stroke android:width="1dp" android:color="@color/gary_border_color" />
        </shape>
    </item>
</selector>